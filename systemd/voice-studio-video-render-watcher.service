[Unit]
Description=Process pending video-studio render jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/.openclaw/workspace
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.openclaw/workspace/skills/voice-studio/scripts:/root/.openclaw/workspace/public-downloads
ExecStart=/usr/bin/python3 /root/.openclaw/workspace/skills/voice-studio/scripts/process_video_render_jobs.py
